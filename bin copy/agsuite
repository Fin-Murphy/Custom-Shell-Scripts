#!/bin/zsh

d1=~/Desktop/orchbrain/oc1
d2=~/Desktop/orchbrain/oc2
d3=~/Desktop/orchbrain/oc3
d4=~/Desktop/orchbrain/oc4

tmux new-session -d -s claude -c $d1
p1=$(tmux display-message -p -t claude '#{pane_id}')
p2=$(tmux split-window -h -t $p1 -c $d2 -P -F '#{pane_id}')
p3=$(tmux split-window -v -t $p1 -c $d3 -P -F '#{pane_id}')
p4=$(tmux split-window -v -t $p2 -c $d4 -P -F '#{pane_id}')

for p in $p1 $p2 $p3 $p4; do
  tmux send-keys -t $p claude C-m
done

tmux attach -t claude
