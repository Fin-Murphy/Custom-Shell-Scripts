#!/bin/zsh

# Check if a filepath argument was provided
if [ $# -eq 0 ]; then
  echo "Usage: $0 <filepath>"
  exit 1
fi

target_dir="$1"

# Verify the directory actually exists
if [ ! -d "$target_dir" ]; then
  echo "Error: Directory '$target_dir' does not exist."
  exit 1
fi

# Create the session and panes, all starting in target_dir
# No -s, so tmux assigns a unique numbered session; capture its ID to target it
session=$(tmux new-session -d -c "$target_dir" -P -F '#{session_id}')
p1=$(tmux display-message -p -t "$session" '#{pane_id}')
p2=$(tmux split-window -h -t $p1 -c "$target_dir" -P -F '#{pane_id}')
p3=$(tmux split-window -v -t $p1 -c "$target_dir" -P -F '#{pane_id}')
p4=$(tmux split-window -v -t $p2 -c "$target_dir" -P -F '#{pane_id}')

tmux send-keys -t $p1 'claude --name programmer --agent programmer' C-m
tmux send-keys -t $p2 'claude --name researcher --agent researcher' C-m
tmux send-keys -t $p3 'claude --name pm --agent pm' C-m
tmux send-keys -t $p4 'claude --name designer --agent designer' C-m

tmux attach -t "$session"
